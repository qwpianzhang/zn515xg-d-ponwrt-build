#!/bin/sh
# ZNXT ZN515XG-D / FiberHome HG5585F 三网通用固件 —— 每次开机执行
#
# 2026-11-14：PassWall / PassWall2 已整体移除，原先这里为绕开 PassWall2
# ln_run() 而重建 /tmp/etc/passwall2/bin 的补丁随之删除（连同 uci-defaults
# 里的核心软链双保险）。那段逻辑只为 /tmp 下那个历史目录服务，与 HomeProxy
# 无关，留着只会平白多建一个空目录。
#
# 现在只做一件幂等的小事：确保 HomeProxy 的运行目录存在。它的 init.d 自己
# 也会 mkdir -p /var/run/homeproxy，这里只是开机顺序上的兜底。
# ---------------------------------------------------------------------------

mkdir -p /var/run/homeproxy 2>/dev/null
chmod 0755 /var/run/homeproxy 2>/dev/null

exit 0
