#!/bin/sh
# ZNXT ZN515XG-D / Airoha AN7581 —— 转发、卸载与 CPU 调频默认值
#
# 【NPU / 无线卸载：结论没变，补上 2026-11-15 的实机数据】
#   1. NPU 硬件与驱动都是好的：dmesg 里 airoha-npu fw 1456.62，
#      /sys/kernel/debug/ppe/config 显示 npu_attached: 1，时钟 800MHz。
#      但 ppe/entries 里全是 UNB 且 packets=0 bytes=0 —— 表项建了却没
#      真正硬件转发。A/B 实测：开 flow_offloading_hw 反而从 91-115 Mbps
#      掉到 54-62 Mbps（约 -40%）。故本版把硬件卸载**恒关**。
#   2. MT7916D/mt7915 没有 HW-RRO，mt76 源码里 NPU 只接 mt7996 分支，
#      无线侧永远不可能走 NPU/WED；唯一有效加速是软件 flow offload。
#   3. 软件 flow offload 让已建立的流绕过 netfilter，与 TPROXY/REDIRECT
#      类代理互斥；但 HomeProxy 的 **TUN 模式**流量走 singtun0（用户态），
#      不进 fw4 forward flowtable，因此可以与卸载共存。
#      该组合 2026-11-15 已真机验证：Google/YouTube 200、国内直连正常、
#      homeproxy_mangle_tun 计数器显示国外流量仍打 mark 走 TUN、
#      conntrack 出现 61-66 条 OFFLOAD 条目。
#
# 【本固件策略（2026-11-15 版）】
#   - 出厂默认 flow_offloading=1 / flow_offloading_hw=0 / proxy_mode=tun。
#     HomeProxy 出厂 main_node=nil 不接管流量，此时开卸载完全安全；
#     用户若启用 OpenClash/Nikki，或把 HomeProxy 切回 redirect/tproxy，
#     offload-guard 会自动把卸载关掉。
#   - packet steering + irqbalance 默认开（不绕过 netfilter，零冲突）。
#   - 新增 /etc/init.d/zn515xg-d-tuning 锁 CPU performance。
#
# 【升级幂等保护】
#   uci-defaults 在 sysupgrade 保留配置后仍会重跑；默认值只在「全新刷机」
#   时写，升级后不改用户设置。第 4/5/6 节是固件自带服务的 enable、闲置
#   服务整理与历史清单清理，每次刷机后都做（幂等）。
# ---------------------------------------------------------------------------

MARK=/etc/zn515xg-d-firstboot

# 是否与卸载冲突的代理在用。HomeProxy 的 TUN / redirect_tun 不算冲突，
# 与 /usr/sbin/offload-switch 的 proxy_enabled() 判定保持一致。
proxy_is_enabled() {
    [ "$(uci -q get openclash.config.enable 2>/dev/null)" = "1" ] && return 0
    [ "$(uci -q get nikki.config.enabled 2>/dev/null)" = "1" ] && return 0
    n="$(uci -q get homeproxy.config.main_node 2>/dev/null)"
    if [ -n "$n" ] && [ "$n" != "nil" ]; then
        case "$(uci -q get homeproxy.config.proxy_mode 2>/dev/null)" in
            tun|redirect_tun) ;;   # TUN 可与软件 offload 共存
            *) return 0 ;;
        esac
    fi
    return 1
}

APPLY_DEFAULTS=1
[ -f "$MARK" ] && APPLY_DEFAULTS=0
proxy_is_enabled && APPLY_DEFAULTS=0

if [ "$APPLY_DEFAULTS" = "1" ]; then
    # 1) 软件 flow offload 默认开；硬件 NPU 卸载恒关（实测降速 40%）
    if [ -f /etc/config/firewall ]; then
        uci -q get firewall.@defaults[0] >/dev/null 2>&1 || uci -q add firewall defaults >/dev/null 2>&1
        uci -q set firewall.@defaults[0].flow_offloading='1'
        uci -q set firewall.@defaults[0].flow_offloading_hw='0'
        # fullcone 是 PonWrt 自带默认值（1），保留不动：只影响 NAT 行为，
        # 与 flow offload 无关，对游戏/PT 有好处。
        uci -q commit firewall
    fi

    # 2) packet steering：多核分摊软中断，不绕过 netfilter → 代理安全
    uci -q get network.@globals[0] >/dev/null 2>&1 || uci -q add network globals >/dev/null 2>&1
    uci -q set network.@globals[0].packet_steering='1'
    uci -q commit network

    # 3) irqbalance：把 PCIe 无线网卡与以太网口的中断摊到 4 个 A53 核上
    if [ -f /etc/config/irqbalance ]; then
        uci -q set irqbalance.irqbalance.enabled='1'
        uci -q commit irqbalance
        if [ -f /etc/init.d/irqbalance ]; then
            /etc/init.d/irqbalance enable
            /etc/init.d/irqbalance restart
        fi
    fi
else
    logger -t zn515xg-d-net-tuning '后台升级后的重启：保留用户自定义的网络/卸载设置' 2>/dev/null || :
fi

# 4) 启用固件自带服务（每次刷机后都做，新 rootfs 的 init.d 需要重新 enable）
for f in /etc/init.d/offload-guard /etc/init.d/zn515xg-d-tuning /usr/sbin/offload-switch; do
    [ -f "$f" ] && chmod +x "$f" 2>/dev/null
done
[ -f /etc/init.d/offload-guard ] && /etc/init.d/offload-guard enable
[ -f /etc/init.d/zn515xg-d-tuning ] && /etc/init.d/zn515xg-d-tuning enable

# 5) 停用确认闲置的服务（家用单 WAN 场景，512MB 内存）
#    radius / airoha-pon-debug 是运营商调试与认证服务，家用无用；
#    独立 sing-box init.d 与 HomeProxy 自带实例无关，留着只会多一个空服务
#    （需要独立使用时 /etc/init.d/sing-box enable 即可恢复）。
#    IPTV 一旦被用户启用就完全不动 iptv / igmpproxy。
for s in radius airoha-pon-debug sing-box; do
    [ -f "/etc/init.d/$s" ] && {
        "/etc/init.d/$s" stop >/dev/null 2>&1
        "/etc/init.d/$s" disable >/dev/null 2>&1
    }
done
if [ "$(uci -q get iptv.config.enabled 2>/dev/null)" != "1" ]; then
    for s in iptv igmpproxy; do
        [ -f "/etc/init.d/$s" ] && {
            "/etc/init.d/$s" stop >/dev/null 2>&1
            "/etc/init.d/$s" disable >/dev/null 2>&1
        }
    done
fi

# 6) 清理历史 sysupgrade.conf 里「保留程序文件」的条目
#    旧版实机为保住手工补丁，把 scripts/、ruleset/、init.d、rc.local、
#    offload-switch 列进了保留清单；本版已把这些修复固化进 rootfs，升级时
#    若继续保留，旧文件会反向覆盖新版。只删精确匹配行，不动用户其他条目。
cleanup_sysupgrade_conf() {
    local f=/etc/sysupgrade.conf t
    [ -f "$f" ] || return 0
    t="$f.tmp.$$"
    grep -vxF \
        -e '/etc/homeproxy/' \
        -e '/etc/homeproxy/ruleset/' \
        -e '/etc/homeproxy/scripts/generate_client.uc' \
        -e '/etc/homeproxy/scripts/firewall_post.ut' \
        -e '/etc/init.d/homeproxy' \
        -e '/usr/sbin/offload-switch' \
        -e '/etc/rc.local' \
        "$f" > "$t" 2>/dev/null && mv "$t" "$f" || rm -f "$t"
}
cleanup_sysupgrade_conf

exit 0
