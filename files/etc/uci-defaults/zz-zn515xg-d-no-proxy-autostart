#!/bin/sh
# ZNXT ZN515XG-D 三网通用固件 —— 首次启动默认值
#
# 目的：PassWall2 与 OpenClash 都编进固件，但刷机后一律不自动启动。
#       开机即可用：PON → WAN → PPPoE/IPoE → IPv4/IPv6 → Wi-Fi → IPTV，
#       代理由用户自己在 LuCI 里启用，且不得同时启用两个。
#
# 【为什么文件名是 zz- 开头】
#   OpenWrt 按文件名字母序执行 /etc/uci-defaults/*。
#   PassWall2 自带的 uci-defaults 叫 luci-app-passwall2（无数字前缀），
#   /etc/config/passwall2 是由它在运行时从 /usr/share/passwall2/0_default_config 拷贝生成的。
#   用 99- 开头会排在它前面、那时配置文件还不存在；zz- 保证本脚本最后执行。
#
# 服务自启状态：
#   PassWall2  init.d = passwall2 / passwall2_server（START=99，装完默认 enabled）
#   OpenClash  init.d = openclash（START=99，装完默认 enabled）
#   两者都必须显式 disable。
# ---------------------------------------------------------------------------

# 1) 关闭两个代理的开机自启
for s in passwall2 passwall2_server openclash; do
    if [ -f "/etc/init.d/$s" ]; then
        "/etc/init.d/$s" disable
        "/etc/init.d/$s" stop 2>/dev/null
    fi
done

# 2) OpenClash 主开关保持关闭（/etc/config/openclash 是 ROM 自带，字段已核实）
if [ -f /etc/config/openclash ]; then
    uci -q set openclash.config.enable='0'
    uci -q set openclash.config.auto_update='0'
    uci -q set openclash.config.enable_custom_dns='0'
    uci -q commit openclash
fi

# 3) PassWall2 主开关保持关闭
#    字段：config global / option enabled（见 0_default_config，出厂已是 '0'，这里兜底）
if [ -f /etc/config/passwall2 ]; then
    uci -q set passwall2.@global[0].enabled='0'
    uci -q set passwall2.@global[0].socks_enabled='0'
    uci -q commit passwall2 2>/dev/null
fi

# 4) 防火墙默认区配置存在性兜底（流卸载/硬件加速由用户在防火墙页自行开启）
if [ -f /etc/config/firewall ]; then
    uci -q get firewall.@defaults[0] >/dev/null || uci -q add firewall defaults >/dev/null
    uci -q commit firewall
fi

# 5) 明确不写死任何运营商参数：
#    /etc/config/pon   serial_number / registration_id / loid / loid_password 保持空
#    /etc/config/iptv  service_vlan / multicast_vlan / igmp_vlan / lan_port 保持空
#    这两份配置由 airoha-ponctl 与 luci-app-iptv 出厂提供，已经是空值，此处不动它们。

exit 0
